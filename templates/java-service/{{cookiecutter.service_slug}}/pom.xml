<?xml version="1.0" encoding="UTF-8"?>
<!--
  Generated from the platform golden path. The platform team keeps the parent,
  plugin versions and quality checks up to date; you focus on business logic.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>{{ cookiecutter.package_name.rsplit('.', 1)[0] }}</groupId>
  <artifactId>{{ cookiecutter.service_slug }}</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>{{ cookiecutter.service_name }}</name>
  <description>{{ cookiecutter.description }}</description>

  <properties>
    <java.version>{{ cookiecutter.java_version }}</java.version>
    <spotless.version>3.10.3</spotless.version>

    <!-- PLATFORM SECURITY PATCHES (Oct 2026). Spring Boot 4.1.1 ships Tomcat 11.0.24 and
         Jackson 3.1.5, which the security gate blocks. The platform team bumps them here
         once, and every new service is born green. Remove them in Lab 3 to see why. -->
    <tomcat.version>11.0.26</tomcat.version>
    <jackson-bom.version>3.1.7</jackson-bom.version>
  </properties>

  <dependencies>
    <!-- HTTP / REST -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Health checks + metrics (cross-cutting concern #1) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Distributed tracing with OpenTelemetry (cross-cutting concern #2) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!-- Code style is not a debate: the build checks it, `mvn spotless:apply` fixes it. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
