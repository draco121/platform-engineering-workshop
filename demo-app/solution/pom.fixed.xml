<?xml version="1.0" encoding="UTF-8"?>
<!--
  FACILITATOR SOLUTION - "Old Faithful" after Lab 1 + Lab 2 fixes.
  Both gates should report PASSED for this file (as of October 2026).
  Copy it over ../pom.xml to show the green build:  cp solution/pom.fixed.xml pom.xml
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.workshop</groupId>
  <artifactId>old-faithful</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <log4j.version>2.26.1</log4j.version>
  </properties>

  <dependencies>
    <!-- Logging. 2.14.1 is the version made famous by "Log4Shell" (Dec 2021). -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j.version}</version>
    </dependency>

    <!-- JSON. A very old line of jackson-databind with a long advisory history. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.3</version>
    </dependency>

    <!-- String utilities. 1.9 is affected by "Text4Shell" (2022). -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.15.0</version>
    </dependency>

    <!-- YAML parsing. -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.7</version>
    </dependency>

    <!-- A perfectly healthy dependency, so you can see what "green" looks like. -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>

    <!-- FIX: iText 5 is AGPL-3.0 -> swapped for Apache PDFBox (Apache-2.0). -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>3.0.8</version>
    </dependency>

    <!-- FIX: the old MySQL driver was relocated, has an unfixed advisory and a
         non-standard license -> swapped for the PostgreSQL driver (BSD-2-Clause). -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.14</version>
    </dependency>

    <!-- Test-only dependency: not shipped to production. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
